{
    "openapi": "3.0.0",
    "info": {
        "title": "Database schema lookup and query APIs",
        "version": "1.1.0",
        "description": "APIs for looking up database table schemas and making bounded, read-only queries to database tables."
    },
    "paths": {
        "/getschema": {
            "get": {
                "summary": "Get all tables and their schemas in the sample database",
                "description": "Return the table and column metadata used to construct read-only queries.",
                "operationId": "getschema",
                "responses": {
                    "200": {
                        "description": "The table names and their schemas",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "required": [
                                            "Table",
                                            "Schema"
                                        ],
                                        "properties": {
                                            "Table": {
                                                "type": "string",
                                                "description": "The table name."
                                            },
                                            "Schema": {
                                                "type": "object",
                                                "description": "A mapping from column name to Athena data type.",
                                                "additionalProperties": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/querydatabase": {
            "post": {
                "summary": "Run a bounded read-only query against the sample database",
                "description": "Send exactly one read-only SELECT statement to the sample database. Comments, quoted identifiers, common table expressions, DDL, data mutations, UNLOAD, and multiple statements are rejected.",
                "operationId": "querydatabase",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "query": {
                                        "type": "string",
                                        "description": "One read-only Athena SELECT statement against the tables returned by getschema. Use unquoted identifiers, no comments or common table expressions, and a reasonable LIMIT for row-returning queries."
                                    }
                                },
                                "required": [
                                    "query"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "A bounded query result and an explicit indication of whether more rows exist",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "rows",
                                        "truncated"
                                    ],
                                    "properties": {
                                        "rows": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "additionalProperties": {
                                                    "type": "string",
                                                    "nullable": true
                                                }
                                            }
                                        },
                                        "truncated": {
                                            "type": "boolean",
                                            "description": "True when additional Athena result rows were not returned."
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The request or SQL statement is missing, malformed, or outside the supported read-only subset."
                    },
                    "500": {
                        "description": "The query could not be completed safely."
                    }
                }
            }
        }
    }
}
